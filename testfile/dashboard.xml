<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="layout.xsd" version="0.1.0" id="dashboard">
    <!-- Fixed header -->
    <flex direction="column" height="56px" id="header">
        <flex direction="row" justify-content="space-between" align-items="center" id="header-flex">
            <block width="200px" id="header-logo"/>
            <block width="120px" id="header-user"/>
        </flex>
    </flex>
    <!-- Remaining viewport -->
    <flex direction="column" grow="1" shrink="1" id="viewport">
        <flex direction="row" grow="1" shrink="1" id="content-wrapper">
            <!-- Navigation -->
            <block width="220px" flex-shrink="0" id="navigation"/>
            <!-- Main dashboard -->
            <flex direction="column" grow="1" shrink="1" padding="16px" gap-row="12" id="main-dashboard">
                <!-- Top metrics -->
                <grid columns="repeat(4,1fr)" height="120px" flex-shrink="0" gap-column="12" id="top-metrics">
                    <block id="metric-1"/>
                    <block id="metric-2"/>
                    <block id="metric-3"/>
                    <block id="metric-4"/>
                </grid>
                <!-- Middle visualization area -->
                <flex direction="row" grow="1" shrink="1" gap-column="12" id="middle-viz">
                    <block flex-grow="2" flex-shrink="1" id="viz-chart-1"/>
                    <block flex-grow="1" flex-shrink="1" id="viz-chart-2"/>
                </flex>
                <!-- Compact activity area -->
                <block height="160px" flex-shrink="0" id="activity-area"/>
            </flex>
        </flex>
    </flex>
    <!-- Fixed footer -->
    <flex height="40px" id="footer">
        <flex direction="row" justify-content="space-between" id="footer-flex">
            <block id="footer-left"/>
            <block id="footer-right"/>
        </flex>
    </flex>
</layout>
