<layout
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="layout.xsd"
    version="0.1.0"
    id="dashboard" >

  <!-- Fixed header -->
  <flex height="56px" id="header">
    <flex
      direction="row"
      justify-content="space-between"
      align-items="center"
      grow="1"
      id="header-flex">
      <block width="200px" height="32px" id="header-logo"/>
      <block width="120px" height="32px" id="header-user"/>
    </flex>
  </flex>


  <!-- Remaining viewport -->
  <flex
    direction="column"
    grow="1"
    shrink="1"
    id="viewport">

    <flex
      direction="row"
      grow="1"
      shrink="1"
      id="content-wrapper">


      <!-- Navigation -->
      <block
        width="220px"
        flex-shrink="0"
        id="navigation"/>


      <!-- Main dashboard -->
      <flex
        direction="column"
        grow="1"
        shrink="1"
        padding="16px"
        gap-row="12"
        id="main-dashboard">


        <!-- Top metrics -->
        <grid
          columns="repeat(4,1fr)"
          height="120px"
          flex-shrink="0"
          gap-column="12"
          id="top-metrics">

          <block id="metric-1"/>
          <block id="metric-2"/>
          <block id="metric-3"/>
          <block id="metric-4"/>

        </grid>


        <!-- Middle visualization area -->
        <flex
          direction="row"
          grow="1"
          shrink="1"
          gap-column="12"
          id="middle-viz">

          <block
            flex-grow="2"
            flex-shrink="1"
            id="viz-chart-1"/>

          <block
            flex-grow="1"
            flex-shrink="1"
            id="viz-chart-2"/>

        </flex>


        <!-- Compact activity area -->
        <block
          height="160px"
          flex-shrink="0"
          id="activity-area"/>


      </flex>

    </flex>

  </flex>


  <!-- Fixed footer -->
  <flex direction="column" height="40px" id="footer">
    <flex
      direction="row"
      justify-content="space-between"
      grow="1"
      id="footer-flex">
      <block width="80px" height="20px" id="footer-left"/>
      <block width="80px" height="20px" id="footer-right"/>
    </flex>
  </flex>

</layout>
